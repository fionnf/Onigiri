# --- core ---
ENVIRONMENT=dev
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- the single owner account, created on first boot ---
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me

# --- database (pgvector and pg_trgm are required) ---
DATABASE_URL=postgresql+asyncpg://onigiri:onigiri@127.0.0.1:5432/onigiri

# --- jobs: "inline" runs captures in the API process, "arq" uses Redis + the worker ---
JOB_BACKEND=inline
REDIS_URL=redis://127.0.0.1:6379

# --- Claude: reads every recipe. Required. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_FRAME_EFFORT=low

# --- OpenAI: optional. Only for speech in videos and semantic search, ---
# --- which Claude has no endpoint for. Leave blank to switch both off. ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Instagram via Apify ---
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
YTDLP_INSTAGRAM_FALLBACK=false

# --- media storage: leave S3 blank to use the local disk ---
MEDIA_DIR=./.media
S3_ENDPOINT_URL=
S3_BUCKET=onigiri
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- guardrails ---
MONTHLY_JOB_CAP=500
MAX_UPLOAD_MB=512
MAX_KEYFRAMES=60
